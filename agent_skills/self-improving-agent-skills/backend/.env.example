# Gemini API key, used by the ADK agents.
# Get one at https://aistudio.google.com/apikey
#
#   cp .env.example .env
#
# Then paste your key below. With this set, the app never asks for a key again.
GOOGLE_API_KEY=

# Optional: run the agents on Ollama Cloud instead of Gemini.
# Get a key at https://ollama.com/settings/keys. Setting this takes precedence
# over GOOGLE_API_KEY.
# OLLAMA_API_KEY=
#
# Any cloud tag from https://ollama.com/search?c=cloud. Defaults to kimi-k3.
# OLLAMA_MODEL=kimi-k3
